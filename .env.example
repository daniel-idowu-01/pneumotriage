# Copy this file to .env and fill in real values. Never commit .env.

# --- Backend / model ---
MODEL_PATH=models/pneumonia_model.keras
IMAGE_SIZE=150
# Tuned to maximize pneumonia recall — do not change without re-validating
# against the model's precision/recall curve (see docs/intended-use.md).
CLASSIFICATION_THRESHOLD=0.8

# --- Database ---
# Local docker-compose default. Point this at your real Postgres instance
# in production (e.g. a managed DB) and never reuse these dev credentials.
DATABASE_URL=postgresql+psycopg://pneumonia:pneumonia@localhost:5432/pneumonia
POSTGRES_USER=pneumonia
POSTGRES_PASSWORD=pneumonia
POSTGRES_DB=pneumonia

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# --- CORS (comma-separated origins the frontend is served from) ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Admin dashboard ---
# Single shared password gating /admin/* and the frontend admin page — not
# a per-user account system. CHANGE BOTH of these before deploying anywhere
# beyond your own machine.
ADMIN_PASSWORD=changeme
SECRET_KEY=dev-secret-change-me

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
